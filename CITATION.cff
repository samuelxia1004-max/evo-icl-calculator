    given-names: Samuel
repository-code: "https://github.com/samuelxia1004-max/evo-icl-calculator"
url: "https://calculator.evo-icl.cn"
keywords:
  - ophthalmology
  - implantable collamer lens
  - EVO ICL
  - vault prediction
  - research software
